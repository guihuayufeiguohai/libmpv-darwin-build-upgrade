+/*
+ * libmpv-darwin-build extension: renderer selection and fallback.
+ *
+ * Upstream libmpv picks its render backend from a hard-coded list that starts
+ * with the legacy gl_video renderer. That means vo=libmpv never reaches
+ * libplacebo's gpu-next, so Dolby Vision Profile 5 (IPT-PQ-C2) is decoded
+ * into the wrong colour space and looks tinted. These two parameters let the
+ * caller choose and inspect the renderer; the default is deliberately
+ * "auto" so existing clients (e.g. media_kit, which passes no extra params)
+ * get gpu-next without any code change on their side.
+ *
+ * For mpv_render_context_create(): data is a const char* (the string itself,
+ * like MPV_RENDER_PARAM_API_TYPE), one of:
+ *
+ *   "auto" (default)  gpu-next -> gpu -> software
+ *   "gpu-next"        gpu-next -> software
+ *   "gpu"             gpu -> software
+ *   "software"        software only
+ *
+ * Backends that cannot be initialised are skipped in that order. The
+ * environment variable MPV_LIBMPV_RENDERER overrides the value passed here
+ * (useful for diagnosing driver problems in a shipped app without rebuilding).
+ *
+ * Note: "software" is the MPV_RENDER_API_TYPE_SW backend. A client that asked
+ * for MPV_RENDER_API_TYPE_OPENGL cannot be switched to it transparently,
+ * because mpv_render_context_render() would still be passing an OpenGL FBO
+ * instead of SW_SIZE/SW_POINTER buffers. Such a client has to recreate the
+ * render context with MPV_RENDER_API_TYPE_SW to get the final fallback.
+ *
+ * For mpv_render_context_get_info(): data is a const char** that receives the
+ * static name of the renderer actually in use ("gpu-next", "gpu" or
+ * "software"), or "unavailable" before a backend has been selected.
+ */
+#define MPV_RENDER_PARAM_LIBMPV_RENDERER ((mpv_render_param_type)0x6d700001)
+
+/**
+ * libmpv-darwin-build extension. For mpv_render_context_get_info() only:
+ * data is a const char** receiving a description of the selection, e.g.
+ * "requested=auto, active=gpu-next, failed=[]" or
+ * "requested=auto, active=gpu, failed=[gpu-next:-12]".
+ * The string belongs to the render context and is valid until it is freed.
+ */
+#define MPV_RENDER_PARAM_LIBMPV_RENDERER_REASON ((mpv_render_param_type)0x6d700002)
+
