+    if (lp->vo) {
+        // Renderer objects first, while the device still exists. uninit()
+        // also destroys the hwdec devices (ctx->hwdec_devs).
+        uninit(lp->vo);
+        mp_mutex_destroy(&lp->vo->params_mutex);
