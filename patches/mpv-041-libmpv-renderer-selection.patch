+// Needed by both the real backend and the "not available" stub below.
+#include "video/out/libmpv.h"
+
+#if HAVE_GL && defined(PL_HAVE_OPENGL)
+
+// ---------------------------------------------------------------------------
+// libmpv render API backend: gpu-next over OpenGL (libmpv-darwin-build)
+//
+// Upstream mpv only exposes the legacy gl_video renderer as a libmpv render
+// backend, so vo=libmpv never reaches libplacebo -- and therefore cannot
+// handle Dolby Vision Profile 5 (IPT-PQ-C2 / PL_COLOR_SYSTEM_DOLBYVISION),
+// which shows up as the familiar colour cast.
+//
+// This adapts vo_gpu_next.c above to a private struct vo with no windowing
+// state, reusing the plain-GL libmpv context that media_kit already creates.
+// ra_gl is *not* a ra_pl, so instead of ra_pl_get() we create our own
+// pl_opengl wrapper on the very same GL context (the same thing
+// gpu_next/context.c does for a normal VO), and wrap the client's FBO with
+// pl_opengl_wrap() for each frame.
+//
+// Renderer selection (auto / gpu-next / gpu / software) lives in
+// vo_libmpv.c; this backend only has to accept or decline the OpenGL API.
+
+#include "mpv/render_gl.h"
+#include "video/out/gpu/libmpv_gpu.h"
+
+struct libmpv_priv {
+    struct libmpv_gpu_context *context;
+    // Private VO: provides priv/log/global/params/osd/hwdec_devs to the VO
+    // functions. Never registered with the player core.
+    struct vo *vo;
+    struct mp_image_params params;
+    // Owned here: uninit() clears the VO's copy of the log pointer.
+    pl_opengl opengl;
+    pl_log pllog;
+};
+
+static int libmpv_init(struct render_backend *ctx, mpv_render_param *params)
+{
+    ctx->priv = talloc_zero(NULL, struct libmpv_priv);
+    struct libmpv_priv *lp = ctx->priv;
+
+    char *api = get_mpv_render_param(params, MPV_RENDER_PARAM_API_TYPE, NULL);
+    if (!api || strcmp(api, MPV_RENDER_API_TYPE_OPENGL) != 0)
+        return MPV_ERROR_NOT_IMPLEMENTED;
+
+    lp->context = talloc_zero(NULL, struct libmpv_gpu_context);
+    *lp->context = (struct libmpv_gpu_context) {
+        .global = ctx->global,
+        .log = ctx->log,
+        .fns = &libmpv_gpu_context_gl,
+    };
+    int err = lp->context->fns->init(lp->context, params);
+    if (err < 0)
+        return err;
+
+    if (!lp->context->ra_ctx || !lp->context->ra_ctx->ra ||
+        !ra_is_gl(lp->context->ra_ctx->ra))
+        return MPV_ERROR_UNSUPPORTED;
+
+    struct vo *vo = talloc_zero(lp, struct vo);
+    vo->log = ctx->log;
+    vo->global = ctx->global;
+    vo->priv = talloc_zero(vo, struct priv);
+    mp_mutex_init(&vo->params_mutex);
+    lp->vo = vo;
+
+    struct priv *p = vo->priv;
+    p->libmpv = true;
+    p->ra_ctx = lp->context->ra_ctx;
+    p->pllog = lp->pllog = mppl_log_create(lp, ctx->log);
+    if (!p->pllog)
+        goto error;
+
+    GL *gl = ra_gl_get(p->ra_ctx->ra);
+    lp->opengl = pl_opengl_create(p->pllog, pl_opengl_params(
+        .allow_software = true,
+        .get_proc_addr_ex = (void *) gl->get_fn,
+        .proc_ctx = gl->fn_ctx,
+    ));
+    if (!lp->opengl) {
+        MP_ERR(ctx, "gpu-next: could not create a libplacebo OpenGL context.\n");
+        goto error;
+    }
+    p->gpu = lp->opengl->gpu;
+
+    if (preinit(vo) < 0) {
+        // preinit() already ran uninit() on failure.
+        mp_mutex_destroy(&vo->params_mutex);
+        lp->vo = NULL;
+        return MPV_ERROR_UNSUPPORTED;
+    }
+
+    ctx->hwdec_devs = vo->hwdec_devs;
+    ctx->driver_caps = video_out_gpu_next.caps;
+    return 0;
+
+error:
+    // preinit() was not reached, so do not call uninit(): it would touch
+    // renderer objects that were never created. destroy() frees the rest.
+    mp_mutex_destroy(&vo->params_mutex);
+    lp->vo = NULL;
+    return MPV_ERROR_UNSUPPORTED;
+}
+
+static bool libmpv_check_format(struct render_backend *ctx, int imgfmt)
+{
+    struct libmpv_priv *lp = ctx->priv;
+    return query_format(lp->vo, imgfmt);
+}
+
+static int libmpv_set_parameter(struct render_backend *ctx, mpv_render_param param)
+{
+    struct libmpv_priv *lp = ctx->priv;
+    struct priv *p = lp->vo->priv;
+
+    switch (param.type) {
+    case MPV_RENDER_PARAM_ICC_PROFILE: {
+        mpv_byte_array *data = param.data;
+        // update_icc() takes ownership of the copy.
+        update_icc(p, bstrdup(NULL, (bstr){data->data, data->size}));
+        return 0;
+    }
+    default:
+        return MPV_ERROR_NOT_IMPLEMENTED;
+    }
+}
+
+static void libmpv_reconfig(struct render_backend *ctx,
+                            struct mp_image_params *params)
+{
+    struct libmpv_priv *lp = ctx->priv;
+    struct vo *vo = lp->vo;
+
+    mp_mutex_lock(&vo->params_mutex);
+    lp->params = *params;
+    vo->params = &lp->params;
+    vo->target_params = NULL;
+    mp_mutex_unlock(&vo->params_mutex);
+}
+
+static void libmpv_reset(struct render_backend *ctx)
+{
+    struct libmpv_priv *lp = ctx->priv;
+    struct priv *p = lp->vo->priv;
+    // Same as VOCTRL_RESET: defer until the next new frame arrives.
+    p->want_reset = true;
+}
+
+static void libmpv_update_external(struct render_backend *ctx, struct vo *vo)
+{
+    struct libmpv_priv *lp = ctx->priv;
+    struct priv *p = lp->vo->priv;
+
+    lp->vo->osd = vo ? vo->osd : NULL;
+    if (vo) {
+        // Options may have changed the interpolation radius.
+        update_options(lp->vo);
+        vo_set_queue_params(vo, 0, p->req_frames);
+    }
+}
+
+static void libmpv_resize(struct render_backend *ctx, struct mp_rect *src,
+                          struct mp_rect *dst, struct mp_osd_res *osd)
+{
+    struct libmpv_priv *lp = ctx->priv;
+    set_rects(lp->vo->priv, *src, *dst, *osd);
+}
+
+static int libmpv_get_target_size(struct render_backend *ctx,
+                                  mpv_render_param *params,
+                                  int *out_w, int *out_h)
+{
+    struct libmpv_priv *lp = ctx->priv;
+
+    struct ra_tex *tex;
+    int err = lp->context->fns->wrap_fbo(lp->context, params, &tex);
+    if (err < 0)
+        return err;
+    *out_w = tex->params.w;
+    *out_h = tex->params.h;
+    return 0;
+}
+
+static int libmpv_render(struct render_backend *ctx, mpv_render_param *params,
+                         struct vo_frame *frame)
+{
+    struct libmpv_priv *lp = ctx->priv;
+    struct priv *p = lp->vo->priv;
+
+    // wrap_fbo() keeps ra_gl's view of the client FBO in sync (color_depth()
+    // and start_frame() consult it). Its ra_tex is an ra_gl proxy, not a
+    // pl_tex, so the render target is wrapped separately below.
+    struct ra_tex *tex;
+    int err = lp->context->fns->wrap_fbo(lp->context, params, &tex);
+    if (err < 0)
+        return err;
+
+    mpv_opengl_fbo *fbo =
+        get_mpv_render_param(params, MPV_RENDER_PARAM_OPENGL_FBO, NULL);
+    if (!fbo)
+        return MPV_ERROR_INVALID_PARAMETER;
+
+    // With no `texture`, pl_opengl_wrap() wraps the opaque framebuffer and
+    // produces a renderable pl_tex (wrapped_fb). A render target does not
+    // need sampling, so that is sufficient and avoids guessing the client's
+    // internal texture format. fbo == 0 means the default framebuffer.
+    pl_tex target = pl_opengl_wrap(p->gpu, pl_opengl_wrap_params(
+        .framebuffer = fbo->fbo,
+        .width = fbo->w,
+        .height = fbo->h,
+    ));
+    if (!target) {
+        MP_ERR(ctx, "gpu-next: could not wrap the render API framebuffer.\n");
+        return MPV_ERROR_UNSUPPORTED;
+    }
+
+    bool flip = GET_MPV_RENDER_PARAM(params, MPV_RENDER_PARAM_FLIP_Y, int, 0);
+    // The host's image is a plain sRGB-encoded RGB surface, like an SDR
+    // swapchain image. DV/HDR metadata is applied by libplacebo on the way
+    // from the source frame to this SDR target.
+    p->libmpv_target = (struct pl_swapchain_frame) {
+        .fbo = target,
+        .flipped = flip,
+        .color_repr = pl_color_repr_rgb,
+        .color_space = {
+            .primaries = PL_COLOR_PRIM_BT_709,
+            .transfer = PL_COLOR_TRC_SRGB,
+        },
+    };
+    draw_frame(lp->vo, frame);
+    p->libmpv_target = (struct pl_swapchain_frame) {0};
+    pl_tex_destroy(p->gpu, &target);
+
+    lp->context->fns->done_frame(lp->context, frame->display_synced);
+    return 0;
+}
+
