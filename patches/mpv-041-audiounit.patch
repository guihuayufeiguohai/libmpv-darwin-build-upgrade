+// ==== Audio tap (local modification) ====
+// Lets an embedder receive a copy of the PCM that is about to be played.
+// The callback runs on the CoreAudio render thread: it must not block, take
+// locks or allocate.
+static void (*audio_tap_cb)(void *data, size_t size, void *ctx) = NULL;
+static void *audio_tap_ctx = NULL;
+
+__attribute__((visibility("default")))
+void mpv_ao_audiounit_set_tap_callback(
+    void (*callback)(void *data, size_t size, void *ctx),
+    void *ctx)
+{
+    audio_tap_cb = callback;
+    audio_tap_ctx = ctx;
+}
+
+// ==== Optional resampling helper (reuses mpv's bundled FFmpeg) ====
+#include <libswresample/swresample.h>
+#include <libavutil/channel_layout.h>
+#include <libavutil/opt.h>
+
+static SwrContext *tap_swr_ctx = NULL;
+
+// Output is fixed to 16 kHz / s16 / mono; input format is dynamic.
+__attribute__((visibility("default")))
+int mpv_ao_audiounit_init_swr(int in_rate, int in_channels, int in_format)
+{
+    enum AVSampleFormat in_fmt;
+    switch (in_format) {
+        case AF_FORMAT_FLOAT:   in_fmt = AV_SAMPLE_FMT_FLT; break;
+        case AF_FORMAT_S16:     in_fmt = AV_SAMPLE_FMT_S16; break;
+        case AF_FORMAT_S32:     in_fmt = AV_SAMPLE_FMT_S32; break;
+        default: return -1;
+    }
+
+    AVChannelLayout out_ch = (AVChannelLayout)AV_CHANNEL_LAYOUT_MONO;
+    AVChannelLayout in_ch = in_channels == 2
+        ? (AVChannelLayout)AV_CHANNEL_LAYOUT_STEREO
+        : (AVChannelLayout)AV_CHANNEL_LAYOUT_MONO;
+
+    swr_free(&tap_swr_ctx);
+    if (swr_alloc_set_opts2(&tap_swr_ctx, &out_ch, AV_SAMPLE_FMT_S16, 16000,
+                            &in_ch, in_fmt, in_rate, 0, NULL) < 0) {
+        swr_free(&tap_swr_ctx);
+        return -1;
+    }
+    if (swr_init(tap_swr_ctx) < 0) {
+        swr_free(&tap_swr_ctx);
+        return -1;
+    }
+    return 0;
+}
+
+// Planar float stereo -> interleaved 16 kHz s16 mono.
+__attribute__((visibility("default")))
+int mpv_ao_audiounit_convert_stereo_float_to_mono_s16(
+    float *left, float *right, int in_samples, int16_t *out_data, int out_capacity)
+{
+    if (!tap_swr_ctx) return -1;
+    const uint8_t *in[2] = { (uint8_t *)left, (uint8_t *)right };
+    uint8_t *out[1] = { (uint8_t *)out_data };
+    return swr_convert(tap_swr_ctx, out, out_capacity, in, in_samples);
+}
+
+__attribute__((visibility("default")))
+void mpv_ao_audiounit_free_swr(void)
+{
+    swr_free(&tap_swr_ctx);
+}
+// ==== Audio tap end ====
+
 struct priv {
     AudioUnit audio_unit;
     double device_latency;
+    bool session_acquired;
+    bool skip_session_management;
 };
 
+// iOS has a single process-wide AVAudioSession, so several ao instances (or
+// several libmpv instances in one process) have to share the activation via a
+// reference count instead of each of them toggling it independently.
+static pthread_mutex_t audiounit_session_lock = PTHREAD_MUTEX_INITIALIZER;
+static int audiounit_session_use_count;
+
 static OSStatus au_get_ary(AudioUnit unit, AudioUnitPropertyID inID, AudioUnitScope inScope, AudioUnitElement inElement, void **data, UInt32 *outDataSize)
 {
     OSStatus err;
@@ -83,6 +164,58 @@ static AudioChannelLayout *convert_layout(AudioChannelLayout *layout, UInt32* si
 }
 
 
+static void acquire_audio_session(struct ao *ao, NSInteger pref_channels,
+                                  AVAudioSessionCategoryOptions options)
+{
+    struct priv *p = ao->priv;
+    AVAudioSession *instance = AVAudioSession.sharedInstance;
+
+    pthread_mutex_lock(&audiounit_session_lock);
+
+    if (audiounit_session_use_count == 0) {
+        [instance setCategory:AVAudioSessionCategoryPlayback withOptions:options error:nil];
+        [instance setMode:AVAudioSessionModeMoviePlayback error:nil];
+        [instance setActive:YES error:nil];
+        [instance setPreferredOutputNumberOfChannels:pref_channels error:nil];
+    }
+
+    audiounit_session_use_count++;
+    p->session_acquired = true;
+
+    MP_VERBOSE(ao, "audio session users: %d\n", audiounit_session_use_count);
+
+    pthread_mutex_unlock(&audiounit_session_lock);
+}
+
+static void release_audio_session(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+
+    if (!p->session_acquired)
+        return;
+
+    pthread_mutex_lock(&audiounit_session_lock);
+
+    if (audiounit_session_use_count > 0)
+        audiounit_session_use_count--;
+    else
+        MP_WARN(ao, "audio session reference count underflow\n");
+
+    p->session_acquired = false;
+
+    if (audiounit_session_use_count == 0) {
+        [AVAudioSession.sharedInstance
+            setActive:NO
+            withOptions:AVAudioSessionSetActiveOptionNotifyOthersOnDeactivation
+            error:nil];
+    } else {
+        MP_VERBOSE(ao, "keeping audio session active for %d other user(s)\n",
+                   audiounit_session_use_count);
+    }
+
+    pthread_mutex_unlock(&audiounit_session_lock);
+}
+
 static OSStatus render_cb_lpcm(void *ctx, AudioUnitRenderActionFlags *aflags,
                               const AudioTimeStamp *ts, UInt32 bus,
                               UInt32 frames, AudioBufferList *buffer_list)
@@ -98,6 +231,17 @@ static OSStatus render_cb_lpcm(void *ctx, AudioUnitRenderActionFlags *aflags,
     end += MP_TIME_S_TO_NS(p->device_latency);
     end += ca_get_latency(ts) + ca_frames_to_ns(ao, frames);
     ao_read_data(ao, planes, frames, end, NULL, true, true);
+
+    // ==== Audio tap: hand the freshly filled PCM to the embedder ====
+    if (audio_tap_cb) {
+        for (UInt32 i = 0; i < buffer_list->mNumberBuffers; i++) {
+            AudioBuffer buf = buffer_list->mBuffers[i];
+            if (buf.mDataByteSize > 0)
+                audio_tap_cb(buf.mData, buf.mDataByteSize, audio_tap_ctx);
+        }
+    }
+    // ==== Audio tap end ====
+
     return noErr;
 }
 
