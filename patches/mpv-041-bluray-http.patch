+// in stream_seek(outer, 0)), so answer them locally instead of letting them
+// fail. Returning > 0 tells stream_seek_unbuffered() the seek succeeded; the
+// stream layer then updates its own position and drops its buffer.
+static int bluray_stream_seek(stream_t *s, int64_t newpos)
+{
+    struct bluray_priv_s *b = s->priv;
+
+    MP_VERBOSE(s, "Ignoring byte seek to %" PRId64 " (delivered %" PRId64
+               " bytes, position is controlled by bd_seek_time).\n",
+               newpos, b->delivered_pos);
+
