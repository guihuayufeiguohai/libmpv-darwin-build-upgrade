+// Declared in stream/stream_lavf.c; used to force the http/https stream
+// implementation instead of autoprobing.
+extern const stream_info_t stream_info_ffmpeg;
+
+/* ---------- HTTP Blu-ray stream callback & opener ---------- */
+static int http_read_cb(void *handle, void *buf, int lba, int num_blocks)
+{
+    struct stream *s = handle;
+    int64_t pos = (int64_t)lba * 2048;
+
+    // stream_seek() returns bool, never a negative value, so the historic
+    // `if (stream_seek(s, pos) < 0)` was always false: a failed seek was
+    // silently ignored and the read below then returned bytes from the OLD
+    // position, producing corrupt mpegts packets.
+    if (!stream_seek(s, pos))
+        return -1;
+
+    int size = num_blocks * 2048;
+    int read_bytes = stream_read(s, buf, size);
+    if (read_bytes != size)
+        return -1;
+    return num_blocks;
+}
+
+static int open_bd_http(stream_t *stream, const char *url)
+{
+    struct bluray_priv_s *b = stream->priv;
+    struct mpv_global *global = stream->global;
+
+    // Force the ffmpeg (http/https) implementation:
+    //  * .sinfo avoids autoprobing -- autoprobe would re-enter
+    //    bdmv_dir_stream_open() (registered ahead of stream_info_ffmpeg) and
+    //    recurse until the stack overflows.
+    //  * STREAM_READ alone leaves origin at 0, and check_origin(0, NET) == 0,
+    //    so the http stream would be rejected as STREAM_UNSAFE.
+    struct stream_open_args args = {
+        .global = global,
+        .flags  = STREAM_READ | STREAM_ORIGIN_DIRECT,
+        .url    = url,
+        .sinfo  = &stream_info_ffmpeg,
+    };
+    struct stream *http_stream = NULL;
+    stream_create_with_args(&args, &http_stream);
+    if (!http_stream)
+        return STREAM_UNSUPPORTED;
+
+    // bd_init() gives us an unopened handle we can attach a read callback to.
+    BLURAY *bd = bd_init();
+    if (!bd) {
+        free_stream(http_stream);
+        return STREAM_UNSUPPORTED;
+    }
+
+    if (bd_open_stream(bd, http_stream, http_read_cb) <= 0) {
+        bd_close(bd);
+        free_stream(http_stream);
+        return STREAM_UNSUPPORTED;
+    }
+
+    b->bd = bd;
+    b->http_stream = http_stream;
+
+    MP_VERBOSE(stream, "Opened Blu-ray over HTTP: %s\n", url);
+    return STREAM_OK;
+}
+/* ---------- end of HTTP additions ---------- */
