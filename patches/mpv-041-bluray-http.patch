+    // move backwards would make stream_tell() disagree with the data libbluray
+    // keeps delivering. Returning 1 makes stream_seek_unbuffered() treat the
+    // request as satisfied and drop its buffer, which is the only effect mpv
+    // actually needs here.
+    s->pos = b->delivered_pos;
+
+    return 1;
+}
