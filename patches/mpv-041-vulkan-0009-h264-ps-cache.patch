+// Remember the SPS/PPS carried in this buffer, if any. Blu-ray m2ts stores
+// them once at the start of the stream; after a seek the decoder can end up
+// with an empty parameter set table, libavcodec then logs "non-existing PPS 0
+// referenced", VideoToolbox answers -12909 (kVTVideoDecoderBadDataErr) for
+// every picture and mpv abandons hardware decoding for the rest of the file.
+static void ps_cache_store(vd_ffmpeg_ctx *ctx, const uint8_t *data, size_t len)
+{
+    const uint8_t *sps = NULL, *pps = NULL;
+    size_t sps_len = 0, pps_len = 0;
+
+    if (!data || len < 4)
+        return;
+
+    for (size_t i = 0; i + 3 < len; ) {
+        if (data[i] || data[i + 1] || data[i + 2] != 1) {
+            i++;
+            continue;
+        }
+        size_t start = i;
+        size_t hdr = i + 3;
+        if (hdr >= len)
+            break;
+        int type = data[hdr] & 0x1f;
+        size_t j = hdr + 1;
+        while (j + 3 < len && (data[j] || data[j + 1] || data[j + 2] != 1))
+            j++;
+        size_t end = (j + 3 < len) ? j : len;
+        if (type == 7 && end > start + 3) {
+            sps = data + start;
+            sps_len = end - start;
+        } else if (type == 8 && end > start + 3) {
+            pps = data + start;
+            pps_len = end - start;
+        }
+        i = end;
+    }
+
+    if (sps && sps_len < 2048) {
+        talloc_free(ctx->sps);
+        ctx->sps = talloc_memdup(ctx, sps, sps_len);
+        ctx->sps_len = sps_len;
+        MP_VERBOSE(ctx->log, "psfix: cached SPS %zu bytes\n", sps_len);
+    }
+    if (pps && pps_len < 2048) {
+        talloc_free(ctx->pps);
+        ctx->pps = talloc_memdup(ctx, pps, pps_len);
+        ctx->pps_len = pps_len;
+        MP_VERBOSE(ctx->log, "psfix: cached PPS %zu bytes\n", pps_len);
+    }
+}
+
 static int send_packet(struct mp_filter *vd, struct demux_packet *pkt)
 {
     vd_ffmpeg_ctx *ctx = vd->priv;
@@ -1185,7 +1255,34 @@
 
     mp_set_av_packet(ctx->avpkt, pkt, &ctx->codec_timebase);
 
-    int ret = avcodec_send_packet(avctx, pkt ? ctx->avpkt : NULL);
+    if (ctx->avpkt && pkt)
+        ps_cache_store(ctx, ctx->avpkt->data, ctx->avpkt->size);
+
+    AVPacket *inject = NULL;
+    if (ctx->inject_ps > 0 && ctx->sps_len && ctx->pps_len && pkt) {
+        int extra = (int)(ctx->sps_len + ctx->pps_len);
+        inject = av_packet_alloc();
+        if (inject && av_new_packet(inject, extra + ctx->avpkt->size) >= 0) {
+            memcpy(inject->data, ctx->sps, ctx->sps_len);
+            memcpy(inject->data + ctx->sps_len, ctx->pps, ctx->pps_len);
+            memcpy(inject->data + extra, ctx->avpkt->data, ctx->avpkt->size);
+            av_packet_copy_props(inject, ctx->avpkt);
+            MP_VERBOSE(vd, "psfix: injected %d bytes of SPS/PPS into a %d byte "
+                       "packet (%d left)\n", extra, ctx->avpkt->size,
