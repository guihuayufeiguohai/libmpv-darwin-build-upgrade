+// Keep the last SPS/PPS we saw, so they can be fed back to the decoder after a
+// seek. Without this, seeking a Blu-ray leaves the decoder with an empty
+// parameter set table: libavcodec logs "non-existing PPS 0 referenced",
+// VideoToolbox answers -12909 (kVTVideoDecoderBadDataErr) for every picture
+// and mpv falls back to software decoding for the rest of the file.
+static void update_ps_cache(vd_ffmpeg_ctx *ctx, const uint8_t *data, size_t len)
+{
+    const uint8_t *sps = NULL, *pps = NULL;
+    size_t sps_len = 0, pps_len = 0;
+
+    if (!data || len < 4)
+        return;
+
+    for (size_t i = 0; i + 3 < len; ) {
+        if (data[i] || data[i + 1] || data[i + 2] != 1) {
+            i++;
+            continue;
+        }
+        size_t start = i;
+        size_t hdr = i + 3;
+        if (hdr >= len)
+            break;
+        int type = data[hdr] & 0x1f;
+        size_t j = hdr + 1;
+        while (j + 3 < len && (data[j] || data[j + 1] || data[j + 2] != 1))
+            j++;
+        size_t end = (j + 3 < len) ? j : len;
+        if (type == 7) {
+            sps = data + start;
+            sps_len = end - start;
+        } else if (type == 8) {
+            pps = data + start;
+            pps_len = end - start;
+        }
+        i = end;
+    }
+
+    if (!sps || !pps || sps_len + pps_len > 4096)
+        return;
+
+    talloc_free(ctx->ps_cache);
+    ctx->ps_cache_len = sps_len + pps_len;
+    ctx->ps_cache = talloc_size(ctx, ctx->ps_cache_len);
+    memcpy(ctx->ps_cache, sps, sps_len);
+    memcpy(ctx->ps_cache + sps_len, pps, pps_len);
+}
