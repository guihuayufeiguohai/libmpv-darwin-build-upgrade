+
+    AVPacket *inject = NULL;
+    if (ctx->inject_ps > 0 && ctx->ps_cache_len && pkt) {
+        inject = av_packet_alloc();
+        if (inject &&
+            av_new_packet(inject, ctx->ps_cache_len + ctx->avpkt->size) >= 0)
+        {
+            memcpy(inject->data, ctx->ps_cache, ctx->ps_cache_len);
+            memcpy(inject->data + ctx->ps_cache_len, ctx->avpkt->data,
+                   ctx->avpkt->size);
+            av_packet_copy_props(inject, ctx->avpkt);
+        } else {
